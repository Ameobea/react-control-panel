{
  "presets": [
    "@babel/preset-env",
    "@babel/react"
  ],
  "plugins": ["@babel/plugin-proposal-class-properties"],
  "env": {
    "esm": {
      "presets": [
        [
          "@babel/preset-env",
          {
            "modules": false
          }
        ],
        "@babel/react"
      ]
    }
  }
}
